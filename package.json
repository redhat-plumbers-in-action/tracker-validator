{
  "name": "tracker-validator",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "build": "esbuild ./src/main.ts --bundle --outdir=dist --platform=node --target=node24.0.0 --packages=bundle --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "test": "vitest run --coverage",
    "update-snapshots": "vitest run --update",
    "all": "yarn && yarn run build && yarn run format && yarn test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redhat-plumbers-in-action/verify-tracker.git"
  },
  "keywords": [
    "actions",
    "jira",
    "bugzilla",
    "validator"
  ],
  "author": "jamacku@redhat.com",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/rest": "22.0.1",
    "@octokit/types": "18.0.0",
    "@probot/octokit-plugin-config": "4.1.0",
    "bugzilla": "3.1.6",
    "deepmerge": "^4.3.1",
    "dotenv": "18.0.5",
    "jira.js": "5.4.0",
    "node-fetch": "3.3.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@actions/github": "9.1.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.3"
  }
}
